{
    "openapi": "3.1.0",
    "info": {
        "title": "ACME Salary Management API",
        "version": "0.1.0"
    },
    "paths": {
        "/api/auth/login": {
            "post": {
                "operationId": "auth-login",
                "description": "Authenticate an HR user and establish a session.",
                "tags": [
                    "auth"
                ],
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/LoginRequest"
                            }
                        }
                    },
                    "required": true
                },
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/auth/logout": {
            "post": {
                "operationId": "auth-logout",
                "description": "End the current session and clear its cookie.",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "sessionAuth": []
                    }
                ],
                "responses": {
                    "204": {
                        "description": "No response body"
                    }
                }
            }
        },
        "/api/auth/me": {
            "get": {
                "operationId": "auth-me",
                "description": "Return the signed-in user and the current CSRF token.",
                "tags": [
                    "auth"
                ],
                "security": [
                    {
                        "sessionAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuthResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/health": {
            "get": {
                "operationId": "health",
                "tags": [
                    "health"
                ],
                "security": [
                    {}
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                },
                                "examples": {
                                    "Ok": {
                                        "value": {
                                            "status": "ok"
                                        },
                                        "summary": "ok"
                                    }
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        },
        "/api/lookups": {
            "get": {
                "operationId": "lookups",
                "description": "Return the reference data used by employee forms and filters.",
                "tags": [
                    "catalog"
                ],
                "security": [
                    {
                        "sessionAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/LookupsResponse"
                                }
                            }
                        },
                        "description": ""
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "AuthResponse": {
                "type": "object",
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/AuthUser"
                    },
                    "csrf_token": {
                        "type": "string"
                    }
                },
                "required": [
                    "csrf_token",
                    "user"
                ]
            },
            "AuthUser": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "full_name": {
                        "type": "string"
                    }
                },
                "required": [
                    "email",
                    "full_name",
                    "id"
                ]
            },
            "CountryLookup": {
                "type": "object",
                "description": "Country row with the currency code flattened for easy client use.",
                "properties": {
                    "code": {
                        "type": "string"
                    },
                    "name": {
                        "type": "string"
                    },
                    "currency_code": {
                        "type": "string"
                    }
                },
                "required": [
                    "code",
                    "currency_code",
                    "name"
                ]
            },
            "CurrencyRateLookup": {
                "type": "object",
                "description": "USD conversion rate used for approximate local-currency display.",
                "properties": {
                    "currency_code": {
                        "type": "string"
                    },
                    "rate_per_usd": {
                        "type": "number",
                        "format": "double"
                    },
                    "updated_at": {
                        "type": "string",
                        "format": "date-time"
                    }
                },
                "required": [
                    "currency_code",
                    "rate_per_usd",
                    "updated_at"
                ]
            },
            "DepartmentLookup": {
                "type": "object",
                "description": "Department option used by employee filters and forms.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": [
                    "id",
                    "name"
                ]
            },
            "HealthResponse": {
                "type": "object",
                "properties": {
                    "status": {
                        "type": "string"
                    }
                },
                "required": [
                    "status"
                ]
            },
            "JobTitleLookup": {
                "type": "object",
                "description": "Job title option including its compensation level.",
                "properties": {
                    "id": {
                        "type": "integer"
                    },
                    "name": {
                        "type": "string"
                    },
                    "level": {
                        "type": "integer"
                    }
                },
                "required": [
                    "id",
                    "level",
                    "name"
                ]
            },
            "LoginRequest": {
                "type": "object",
                "description": "Reject unknown input fields instead of silently ignoring them.",
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email"
                    },
                    "password": {
                        "type": "string",
                        "writeOnly": true
                    }
                },
                "required": [
                    "email",
                    "password"
                ]
            },
            "LookupsResponse": {
                "type": "object",
                "description": "Full lookup payload consumed once by the frontend query cache.",
                "properties": {
                    "countries": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CountryLookup"
                        }
                    },
                    "departments": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/DepartmentLookup"
                        }
                    },
                    "job_titles": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/JobTitleLookup"
                        }
                    },
                    "currency_rates": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/CurrencyRateLookup"
                        }
                    }
                },
                "required": [
                    "countries",
                    "currency_rates",
                    "departments",
                    "job_titles"
                ]
            }
        },
        "securitySchemes": {
            "sessionAuth": {
                "type": "apiKey",
                "in": "cookie",
                "name": "acme_session"
            }
        }
    }
}